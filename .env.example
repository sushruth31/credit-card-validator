# Copy to .env at the repo root. Both workspaces read this one file:
# the server via `node --env-file-if-exists`, the client via Vite's envDir.
# Every value below is optional in development and validated at startup —
# a bad or missing one aborts the process with the variable named.

# --- Server ------------------------------------------------------------------

# Port the Express API listens on. Must be an integer 1-65535.
# Optional; defaults to 3001.
PORT=3001

# Exact browser origin permitted by CORS, scheme and port included.
# Optional in development (defaults to the Vite dev server on :5173).
# REQUIRED when NODE_ENV=production — startup fails rather than guess.
CORS_ORIGIN=http://localhost:5173

# Set to "production" when deployed. Anything else is treated as development.
NODE_ENV=development

# --- Client ------------------------------------------------------------------

# Absolute base URL of the API, including the /api prefix. Vite inlines VITE_*
# at build time, so this is a build-time input, not a runtime one.
# Optional for `npm run dev`; REQUIRED before deploying — the build succeeds
# without it, but the resulting bundle throws on load rather than quietly
# calling localhost.
VITE_API_URL=http://localhost:3001/api
